# Copy to web/.env.local (scripts/setup-local-env.sh does this). Never commit .env.local.

# "direct" runs pipeline stages in-process; "n8n" sends jobs through the local n8n workflows.
ACS_ORCHESTRATOR=direct
ACS_N8N_URL=http://127.0.0.1:5678
# Shared secret between the app and n8n (min 16 chars; same value as in n8n/.env).
ACS_ORCHESTRATOR_TOKEN=

# Optional paths (defaults: repository = parent of web/, data = <repo>/data)
# ACS_REPO_ROOT=
# ACS_DATA_DIR=
# ACS_PYTHON=python3

# Upload limits and retries
ACS_MAX_IMAGE_MB=20
ACS_MAX_VIDEO_MB=500
ACS_MAX_RETRIES=3

# Cost estimates (labelled as estimates in the UI)
ACS_FLOW_COST_PER_CREDIT=0
ACS_COST_CURRENCY=USD

# Optional paid Claude API mode. Disabled unless BOTH a key and a budget > 0 are set.
# Claude Pro / Claude Code subscriptions do not provide this; it needs an Anthropic API key.
# ANTHROPIC_API_KEY=
# ACS_ANTHROPIC_MODEL=claude-opus-5-5
ACS_AI_BUDGET_USD=0
