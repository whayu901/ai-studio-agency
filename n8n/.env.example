# Copy to n8n/.env (scripts/setup-local-env.sh does this with random values). Never commit n8n/.env.
N8N_ENCRYPTION_KEY=change-me-32-random-characters
ACS_ORCHESTRATOR_TOKEN=change-me-same-value-as-web/.env.local
ACS_APP_URL=http://host.docker.internal:3000
GENERIC_TIMEZONE=Asia/Jakarta
# Host port for the n8n UI/webhooks (change if 5678 is taken by another n8n)
N8N_HOST_PORT=5678
