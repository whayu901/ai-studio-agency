{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-analysis.schema.json",
  "title": "Reference video analysis (Mode B)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "source_manifest", "prompt_version", "rights_basis", "summary", "shots", "global_observations", "unknowns", "adaptation_plan"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "source_manifest": { "type": "string" },
    "prompt_version": { "type": "string" },
    "rights_basis": { "enum": ["owned", "licensed", "written_permission", "internal_test_only"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "frames_reviewed", "sampling_interval_seconds", "format", "pacing"],
      "properties": {
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "frames_reviewed": { "type": "integer", "minimum": 1 },
        "sampling_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "format": { "type": "string" },
        "pacing": { "type": "string" }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "approx_start_seconds", "approx_end_seconds", "evidence_frames", "observations"],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^R[0-9]{2,3}$" },
          "approx_start_seconds": { "type": "number", "minimum": 0 },
          "approx_end_seconds": { "type": "number", "minimum": 0 },
          "evidence_frames": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } }
        }
      }
    },
    "global_observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "unknowns": {
      "description": "Things the frames cannot show (audio, exact dialogue, motion between samples...).",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "adaptation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "borrow_structure", "make_original", "must_not_copy", "script_fit_notes"],
      "properties": {
        "character_id": { "type": "string" },
        "borrow_structure": { "type": "array", "items": { "type": "string" } },
        "make_original": { "type": "array", "items": { "type": "string" } },
        "must_not_copy": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "script_fit_notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "statement", "certainty", "basis"],
      "properties": {
        "aspect": {
          "enum": [
            "composition",
            "framing",
            "camera_movement",
            "timing",
            "expression",
            "gesture",
            "character_movement",
            "background",
            "lighting",
            "atmosphere",
            "camera_imperfection",
            "transition",
            "text_overlay",
            "product",
            "wardrobe",
            "other"
          ]
        },
        "statement": { "type": "string", "minLength": 1 },
        "certainty": {
          "enum": ["observed", "inferred", "unknown"],
          "description": "observed = visible in a frame; inferred = reasoned from several frames; unknown = cannot be determined from frames."
        },
        "basis": { "type": "string", "description": "Which frames / what evidence supports this." },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    }
  }
}
