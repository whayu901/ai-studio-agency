{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production.schema.json",
  "title": "Production result (one ad job)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "mode",
    "character_id",
    "brief",
    "reference_video_manifest",
    "duration_seconds",
    "aspect_ratio",
    "visual_style",
    "prompt_versions",
    "concept",
    "script",
    "storyboard",
    "character_consistency",
    "flow_prompts",
    "reference_assets",
    "quality_checks",
    "status",
    "human_review"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "mode": { "enum": ["original", "reference_guided"] },
    "character_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "brief": { "type": "string", "description": "Repo-relative path to the brief JSON." },
    "reference_video_manifest": {
      "type": ["string", "null"],
      "description": "Path to the frame manifest (required for reference_guided)."
    },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
    "aspect_ratio": { "enum": ["9:16", "16:9", "1:1", "4:5"] },
    "visual_style": { "type": "string" },
    "prompt_versions": {
      "type": "object",
      "description": "prompt id -> version used, e.g. {\"original-creation\": \"0.1.0\"}",
      "additionalProperties": { "type": "string" }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "angle", "hook", "key_message", "target_audience"],
      "properties": {
        "title": { "type": "string" },
        "angle": { "type": "string" },
        "hook": { "type": "string" },
        "key_message": { "type": "string" },
        "target_audience": { "type": "string" },
        "alternatives_considered": { "$ref": "#/$defs/stringList" }
      }
    },
    "script": { "type": "string", "description": "Full spoken script. May be empty while DRAFT." },
    "claims_used": {
      "type": "array",
      "description": "Each product claim the script makes, copied from the brief's verified_claims.",
      "items": { "type": "string" }
    },
    "storyboard": { "type": "array", "items": { "$ref": "#/$defs/shot" } },
    "character_consistency": { "$ref": "#/$defs/stringList" },
    "flow_prompts": { "type": "array", "items": { "$ref": "#/$defs/flowPrompt" } },
    "reference_assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "quality_checks": { "type": "array", "items": { "$ref": "#/$defs/qualityCheck" } },
    "status": {
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "READY_FOR_MANUAL_RENDER",
        "RENDERED_PENDING_QC",
        "APPROVED",
        "REJECTED"
      ]
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reviewer", "approved_on", "notes"],
      "properties": {
        "required": { "const": true },
        "reviewer": { "type": ["string", "null"] },
        "approved_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "seconds": { "type": "number", "minimum": 0 },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "clip_id",
        "start_seconds",
        "end_seconds",
        "purpose",
        "setting",
        "framing",
        "camera_movement",
        "action",
        "facial_expression",
        "dialogue",
        "product_visibility",
        "transition_out"
      ],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^S[0-9]{2,3}$" },
        "clip_id": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
        "start_seconds": { "$ref": "#/$defs/seconds" },
        "end_seconds": { "$ref": "#/$defs/seconds" },
        "purpose": { "enum": ["hook", "problem", "demo", "benefit", "proof", "cta", "other"] },
        "setting": { "type": "string" },
        "lighting": { "type": "string" },
        "framing": { "type": "string" },
        "camera_movement": { "type": "string" },
        "action": { "type": "string" },
        "gestures": { "type": "string" },
        "facial_expression": { "type": "string" },
        "dialogue": { "type": ["string", "null"] },
        "on_screen_text": { "type": ["string", "null"] },
        "product_visibility": { "type": "string" },
        "transition_out": { "type": "string" }
      }
    },
    "flowPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "start_seconds",
        "end_seconds",
        "model_id",
        "generation_mode",
        "ingredients",
        "prompt",
        "dialogue"
      ],
      "properties": {
        "clip_id": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
        "start_seconds": { "$ref": "#/$defs/seconds" },
        "end_seconds": { "$ref": "#/$defs/seconds" },
        "model_id": { "type": "string", "description": "An id from config/google-flow.json" },
        "generation_mode": {
          "enum": ["text_to_video", "frames_to_video", "ingredients_to_video", "video_to_video"]
        },
        "ingredients": {
          "description": "Repo-relative image paths to upload to Flow for this clip, in order.",
          "type": "array",
          "items": { "type": "string" }
        },
        "start_frame": { "type": ["string", "null"] },
        "end_frame": { "type": ["string", "null"] },
        "prompt": { "type": "string", "minLength": 1 },
        "avoid": { "$ref": "#/$defs/stringList" },
        "dialogue": { "type": ["string", "null"] },
        "continuity_from": { "type": ["string", "null"], "pattern": "^C[0-9]{2,3}$" },
        "notes": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "character_id", "rights_basis"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "character_reference",
            "product_image",
            "reference_video",
            "reference_frame",
            "start_frame",
            "end_frame"
          ]
        },
        "character_id": { "type": ["string", "null"] },
        "rights_basis": {
          "enum": ["owned", "licensed", "written_permission", "internal_test_only", "unknown"]
        }
      }
    },
    "qualityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "dimension", "min_pass_score", "score", "notes"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^QC[0-9]{2}$" },
        "dimension": { "type": "string" },
        "clip_id": { "type": ["string", "null"] },
        "min_pass_score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "score": {
          "description": "1-5 after a human has watched the render; null before rendering.",
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "notes": { "type": "string" }
      }
    }
  }
}
