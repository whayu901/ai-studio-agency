{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-registry.schema.json",
  "title": "Character registry index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "characters"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "profile"],
        "properties": {
          "character_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
          "profile": { "type": "string", "pattern": "^characters/[a-z][a-z0-9_]{1,39}/character\\.json$" }
        }
      }
    }
  }
}
